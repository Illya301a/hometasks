doctype html
html
  head
    title= title
    link(rel="stylesheet" href="/css/style.css")
    link(rel="icon" href="/favicon.ico")
  
  body(class=theme)
    .container
      h1= title
      a.back-link(href="/users") ← До користувачів
      
      .user-detail-card
        h2= user.name
        p Email: #{user.email}
        p Вік: #{user.age}
        p Місто: #{user.city}
        p ID: #{user.id}
        
        .navigation
          a.btn.btn-secondary(href="/users") До користувачів
          a.btn.btn-primary(href="/") На головну
          if isAuthenticated
            a.btn.btn-success(href="/profile") Профіль
          else
            a.btn.btn-success(href="/login") Вхід 